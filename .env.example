# =============================================================================
# SALLY — Variables de entorno
# Copia este fichero como .env en la raíz del proyecto y rellena los valores.
# Las variables sin valor son opcionales: el conector correspondiente se desactiva.
# =============================================================================

# ── Google AI Studio — Gemini Live API (único LLM del sistema) ────────────────
# Obtener en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modelo para la sesión de voz nativa (Gemini Live API, speech-to-speech):
GOOGLE_LIVE_MODEL=gemini-3.1-flash-live-preview

# ── Google Calendar ───────────────────────────────────────────────────────────
# OAuth2 para leer el calendario del usuario.
# Obtener en: https://console.cloud.google.com → APIs → Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Token específico para Gmail (scopes: gmail.readonly + gmail.send).
# Si usa el mismo OAuth2 que Calendar con scopes ampliados, deja vacío
# y se reutilizará GOOGLE_REFRESH_TOKEN.
GMAIL_REFRESH_TOKEN=

# ── Spotify ───────────────────────────────────────────────────────────────────
# Obtener en: https://developer.spotify.com/dashboard
# El refresh token DEBE haberse autorizado con estos scopes:
#   user-read-currently-playing
#   user-read-playback-state
#   user-modify-playback-state
# (los dos últimos son necesarios para que SALLY pueda poner / pausar / saltar canciones).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── Puertos ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=5173
WEARABLE_PORT=3002
SENSORS_PORT=3003

# ── WebSocket (frontend) ──────────────────────────────────────────────────────
# En Docker, el browser se conecta a localhost. En producción, cambia el host.
VITE_WS_URL=ws://localhost:3001/ws
VITE_WS_SALLY_URL=ws://localhost:3001/ws/sally

# ── Misc ──────────────────────────────────────────────────────────────────────
ENV=development
# Nivel de log del backend. Opciones: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Simuladores (inyectado automáticamente por Docker Compose) ────────────────
# Solo necesario para desarrollo local fuera de Docker:
# WEARABLE_WS_URL=ws://localhost:3002/ws
# SENSORS_WS_URL=ws://localhost:3003/ws
